# ==============================================================================
# RailFog — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local configuration.
# DO NOT commit files containing actual secrets to version control (PLAT-15).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Daemon Configuration (PLAT-1)
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'production', or 'test'
DENO_ENV=development

# Service port (default: 8080 for runtime, 8081 for control plane, 8000 for dev)
PORT=8080

# Control Plane API URL (used by railfog-runtime, gateway, and the rail CLI)
RAILFOG_CONTROL_URL=http://localhost:8081
RAILFOG_CONTROL_PLANE_URL=http://localhost:8081

# Default Tenant / Organization and Project scope (PLAT-7, PLAT-18)
RAILFOG_ORG_ID=org_default
RAILFOG_PROJECT_ID=project_default

# ------------------------------------------------------------------------------
# 2. Security & Secrets Management (PLAT-15)
# ------------------------------------------------------------------------------
# Master encryption key used by the Control Plane to encrypt project secrets at rest.
# Must be a 32-byte (256-bit) hexadecimal or Base64 string in production.
# Example 32-byte hex: openssl rand -hex 32
RAILFOG_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. Runtime Fail-Static Snapshot Cache (PLAT-8)
# ------------------------------------------------------------------------------
# Local disk directory where railfog-runtime caches immutable routing snapshots.
# Enables fail-static traffic serving even during total control-plane outages.
RAILFOG_SNAPSHOT_CACHE_DIR=.railfog/snapshots

# ------------------------------------------------------------------------------
# 4. Logging & Observability (PLAT-13, PLAT-15)
# ------------------------------------------------------------------------------
# Structured logging output level: 'debug', 'info', 'warn', 'error'
RAILFOG_LOG_LEVEL=info

# OpenTelemetry OTLP exporter endpoint for metrics collection (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/metrics
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer your-otlp-token

# ------------------------------------------------------------------------------
# 5. Production Cloud Providers (PLAT-16, PLAT-17)
# ------------------------------------------------------------------------------
# In local development (rail dev), SQLite and LocalFS are used automatically.
# The following credentials are only required when running production cloud adapters:

# Cloudflare KV & Queues Provider (eventual-consistency KV and background queues)
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_KV_NAMESPACE_ID=your-kv-namespace-id
# CLOUDFLARE_QUEUE_ID=your-queue-id

# Cloudflare R2 / S3-Compatible Object Storage Provider (content-addressed artifacts & blobs)
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=railfog-production-artifacts
# R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com

# Deno Deploy KV Provider (strong-consistency KV with atomic CAS support)
# DENO_KV_ACCESS_TOKEN=your-deno-deploy-kv-token
# DENO_KV_DATABASE_URL=https://api.deno.com/databases/<database-id>/connect
