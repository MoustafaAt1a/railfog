# syntax=docker/dockerfile:1
# spec: contracts/platform.contract.md#PLAT-1 — Stage 1 deployment topology: control plane on 8081
# spec: contracts/platform.contract.md#PLAT-4 — Isolation, defense in depth, unprivileged execution, capability dropping
# spec: contracts/platform.contract.md#PLAT-19 — Repository packaging structure: infra/
# spec: tasks/milestone-0.6-public-beta/T-0603-production-packaging-spec.md

# Stage 1: Build and dependency caching stage
FROM denoland/deno:alpine AS builder
WORKDIR /app
ENV DENO_DIR=/app/.deno_dir
COPY deno.json* ./
COPY . .
RUN deno cache apps/api/control-server.ts cli/main.ts

# Stage 2: Minimal runtime image for railfog-control
FROM denoland/deno:alpine AS runner
WORKDIR /app
ENV DENO_DIR=/app/.deno_dir

# spec: contracts/platform.contract.md#PLAT-4 — Create unprivileged user (UID 10001) for defense in depth
RUN addgroup -g 10001 railfog && \
    adduser -u 10001 -G railfog -s /bin/sh -D railfog && \
    apk add --no-cache curl

# Copy project files with unprivileged ownership
COPY --chown=10001:10001 --from=builder /app /app

# spec: contracts/platform.contract.md#PLAT-1 — Control plane port (8081)
EXPOSE 8081

# spec: contracts/platform.contract.md#PLAT-4 — Switch to unprivileged non-root user
USER 10001:10001

# spec: contracts/platform.contract.md#PLAT-1 — Native healthcheck probing control plane /healthz
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD curl -f http://localhost:8081/healthz || exit 1

# spec: contracts/platform.contract.md#PLAT-1 — Launch control plane daemon
CMD ["run", "--allow-all", "apps/api/control-server.ts"]
